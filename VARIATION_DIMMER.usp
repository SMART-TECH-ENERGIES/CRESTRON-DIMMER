/*******************************************************************************************
  SIMPL+ Module Information
*******************************************************************************************/
/*
Dealer Name:
System Name:
System Number:
Programmer:
Comments:    Module de contrôle variateur avec gestion du ramp, des scènes et de la mémoire
             de niveau. Supporte appui court (toggle/scène) et appui long (ramp dimming).
*/
/*******************************************************************************************
  Compiler Directives
*******************************************************************************************/
#CATEGORY "46" "VARIATION" // Custom
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
*******************************************************************************************/
DIGITAL_INPUT   ON_OFF,
                VAR_CLK,
                VAR_PLUS_MOINS,
                VAR_PLUS,
                VAR_MOINS,
                PRESS_ON,
                PRESS_OFF,
                MEMORISE,
                SCENE_1_PRESS,
                SCENE_2_PRESS,
                SCENE_3_PRESS,
                SCENE_4_PRESS,
                _SKIP_;
ANALOG_INPUT    VAR_FB,
                _SKIP_;

DIGITAL_OUTPUT  VAR_PLUS_FB,
                VAR_MOINS_FB,
                PULSE_ON,
                PULSE_OFF,
                ON_OFF_FB,
                OFF_FB,
                _SKIP_;
ANALOG_OUTPUT   VAR,
                _SKIP_;

/*******************************************************************************************
  Parameters
*******************************************************************************************/
INTEGER_PARAMETER   _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    RAMP_TIME,       // Durée du ramp en ms (100-65535)
                    TEMPO,           // Délai appui long en ticks (1 tick = 10ms)
                    SCENE1,          // Niveau scène 1 (0-65535)
                    SCENE2,          // Niveau scène 2 (0-65535)
                    SCENE3,          // Niveau scène 3 (0-65535)
                    SCENE4,          // Niveau scène 4 (0-65535)
                    NIVEAU_MINIMUM,  // Niveau minimum du ramp (0-65534)
                    NIVEAU_MAXIMUM;  // Niveau maximum du ramp (1-65535)

/*******************************************************************************************
  Parameter Properties
*******************************************************************************************/
#BEGIN_PARAMETER_PROPERTIES RAMP_TIME
    propValidUnits = unitDecimal;
    propDefaultUnit = unitDecimal;
    propBounds = 100, 65535;
    propDefaultValue = 3000;
    propShortDescription = "Durée du ramp (ms)";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES TEMPO
    propValidUnits = unitDecimal;
    propDefaultUnit = unitDecimal;
    propBounds = 1, 65535;
    propDefaultValue = 50;
    propShortDescription = "Délai appui long (x10ms, ex: 50=500ms)";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES SCENE1, SCENE2, SCENE3, SCENE4
    propValidUnits = unitDecimal;
    propDefaultUnit = unitDecimal;
    propBounds = 0, 65535;
    propDefaultValue = 32767;
    propShortDescription = "Niveau de scène (0-65535)";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES NIVEAU_MINIMUM
    propValidUnits = unitDecimal;
    propDefaultUnit = unitDecimal;
    propBounds = 0, 65534;
    propDefaultValue = 0;
    propShortDescription = "Niveau minimum du ramp (0-65535, < NIVEAU_MAXIMUM)";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES NIVEAU_MAXIMUM
    propValidUnits = unitDecimal;
    propDefaultUnit = unitDecimal;
    propBounds = 1, 65535;
    propDefaultValue = 65535;
    propShortDescription = "Niveau maximum du ramp (0-65535, > NIVEAU_MINIMUM)";
#END_PARAMETER_PROPERTIES

/*******************************************************************************************
  Global Variables
*******************************************************************************************/
INTEGER     LAST_VAR,              // Dernier niveau avant extinction
            SENS_DE_VARIATION,     // Direction du ramp : 0 = descend, 1 = monte
            A_SUBI_UNE_VARIATION;  // Flag : un ramp a eu lieu pendant l'appui

RAMP_INFO   LightInfo;
SIGNED_INTEGER status;

/*******************************************************************************************
  Functions
*******************************************************************************************/

// Met à jour ON_OFF_FB et OFF_FB selon le niveau passé
Function UpdateOnOffFB(INTEGER niveau) {
    IF (niveau > 0) {
        ON_OFF_FB = 1;
        OFF_FB = 0;
    } ELSE {
        ON_OFF_FB = 0;
        OFF_FB = 1;
    }
}

// Lance le ramp vers une direction donnée (1 = monte vers MAX, 0 = descend vers MIN)
// Met à jour les feedbacks VAR_PLUS_FB / VAR_MOINS_FB et ON_OFF_FB
Function StartRampInDirection(INTEGER direction) {
    IF (direction = 1) {
        LightInfo.rampTargetValue = NIVEAU_MAXIMUM;
        VAR_PLUS_FB = 1;
        VAR_MOINS_FB = 0;
    } ELSE {
        LightInfo.rampTargetValue = NIVEAU_MINIMUM;
        VAR_MOINS_FB = 1;
        VAR_PLUS_FB = 0;
    }
    LightInfo.rampTransitionTime = RAMP_TIME;
    status = CreateRamp(VAR, LightInfo);
    IF (status <> 0) {
        TRACE("CreateRamp error: %d\n", status);
    }
    ON_OFF_FB = 1;
    OFF_FB = 0;
}

// Lance un ramp en alternant la direction à chaque appui (toggle)
Function StartDimRamp() {
    IF (SENS_DE_VARIATION = 0) {
        SENS_DE_VARIATION = 1;
        StartRampInDirection(1);
    } ELSE {
        SENS_DE_VARIATION = 0;
        StartRampInDirection(0);
    }
    A_SUBI_UNE_VARIATION = 1;
}

// Arrête le ramp, sauvegarde le niveau réel (VAR_FB) et met à jour le feedback
Function StopDimRamp() {
    A_SUBI_UNE_VARIATION = 0;
    StopRamp(VAR);
    VAR_PLUS_FB = 0;
    VAR_MOINS_FB = 0;
    LAST_VAR = VAR_FB;        // VAR_FB = niveau réel confirmé par l'équipement
    UpdateOnOffFB(VAR_FB);
}

// Rappelle une scène (appui court) : sauvegarde l'ancien niveau et applique le niveau de scène
Function RecallScene(INTEGER sceneValue) {
    LAST_VAR = VAR_FB;
    VAR = sceneValue;
    UpdateOnOffFB(sceneValue);
    CancelAllWait();
}

/*******************************************************************************************
  Event Handlers
*******************************************************************************************/

// Source de vérité pour les feedbacks — corrige tout décalage avec l'équipement réel
CHANGE VAR_FB {
    UpdateOnOffFB(VAR_FB);
}

PUSH ON_OFF {
    IF (VAR_FB = 0) {
        IF (LAST_VAR = 0) {
            LAST_VAR = NIVEAU_MAXIMUM;
        }
        VAR = LAST_VAR;
        PULSE(20, PULSE_ON);
        UpdateOnOffFB(LAST_VAR);
    } ELSE {
        LAST_VAR = VAR_FB;
        VAR = 0;
        PULSE(20, PULSE_OFF);
        UpdateOnOffFB(0);
    }
}

PUSH VAR_CLK {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE VAR_CLK {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        TRACE("VAR_CLK toggle - LAST_VAR: %u\n", LAST_VAR);
        IF (VAR_FB = 0) {
            IF (LAST_VAR = 0) {
                LAST_VAR = NIVEAU_MAXIMUM;
            }
            VAR = LAST_VAR;
            PULSE(20, PULSE_ON);
            UpdateOnOffFB(LAST_VAR);
        } ELSE {
            LAST_VAR = VAR_FB;
            VAR = 0;
            PULSE(20, PULSE_OFF);
            UpdateOnOffFB(0);
        }
        CancelAllWait();
    }
}

PUSH VAR_PLUS_MOINS {
    StartDimRamp();
}

RELEASE VAR_PLUS_MOINS {
    StopRamp(VAR);
    VAR_PLUS_FB = 0;
    VAR_MOINS_FB = 0;
    LAST_VAR = VAR_FB;
}

PUSH VAR_PLUS {
    SENS_DE_VARIATION = 1;
    StartRampInDirection(1);
}

RELEASE VAR_PLUS {
    StopRamp(VAR);
    LAST_VAR = VAR_FB;
}

PUSH VAR_MOINS {
    SENS_DE_VARIATION = 0;
    StartRampInDirection(0);
}

RELEASE VAR_MOINS {
    StopRamp(VAR);
    LAST_VAR = VAR_FB;
}

PUSH PRESS_ON {
    IF (LAST_VAR = 0) {
        LAST_VAR = NIVEAU_MAXIMUM;
    }
    VAR = LAST_VAR;
    PULSE(20, PULSE_ON);
    UpdateOnOffFB(LAST_VAR);
}

PUSH PRESS_OFF {
    TRACE("PRESS_OFF - LAST_VAR: %u\n", LAST_VAR);
    IF (VAR_FB > 0) {
        LAST_VAR = VAR_FB;
    }
    VAR = 0;
    PULSE(20, PULSE_OFF);
    UpdateOnOffFB(0);
}

PUSH MEMORISE {
    IF (VAR_FB > 0) {
        LAST_VAR = VAR_FB;
    }
}

PUSH SCENE_1_PRESS {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE SCENE_1_PRESS {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        RecallScene(SCENE1);
    }
}

PUSH SCENE_2_PRESS {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE SCENE_2_PRESS {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        RecallScene(SCENE2);
    }
}

PUSH SCENE_3_PRESS {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE SCENE_3_PRESS {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        RecallScene(SCENE3);
    }
}

PUSH SCENE_4_PRESS {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE SCENE_4_PRESS {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        RecallScene(SCENE4);
    }
}

/*******************************************************************************************
  Main()
*******************************************************************************************/
Function Main() {
    SENS_DE_VARIATION = 0;
    A_SUBI_UNE_VARIATION = 0;
    VAR_PLUS_FB = 0;
    VAR_MOINS_FB = 0;
    // Niveau par défaut au démarrage : niveau maximum configuré
    LAST_VAR = NIVEAU_MAXIMUM;
}
