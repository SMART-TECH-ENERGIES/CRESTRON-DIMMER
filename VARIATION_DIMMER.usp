/*******************************************************************************************
  SIMPL+ Module Information
*******************************************************************************************/
/*
Dealer Name:
System Name:
System Number:
Programmer:
Comments:    Module de contrôle variateur avec gestion du ramp, des scènes et de la mémoire
             de niveau. Supporte appui court (toggle/scène) et appui long (ramp dimming).
*/
/*******************************************************************************************
  Compiler Directives
*******************************************************************************************/
#CATEGORY "46" "VARIATION" // Custom
#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
*******************************************************************************************/
DIGITAL_INPUT   ON_OFF,
                VAR_CLK,
                VAR_PLUS_MOINS,
                VAR_PLUS,
                VAR_MOINS,
                PRESS_ON,
                PRESS_OFF,
                MEMORISE,
                SCENE_1_PRESS,
                SCENE_2_PRESS,
                SCENE_3_PRESS,
                SCENE_4_PRESS,
                _SKIP_;
ANALOG_INPUT    VAR_FB,
                _SKIP_;

DIGITAL_OUTPUT  VAR_PLUS_FB,
                VAR_MOINS_FB,
                PULSE_ON,
                PULSE_OFF,
                ON_OFF_FB,
                OFF_FB,
                _SKIP_;
ANALOG_OUTPUT   VAR,
                _SKIP_;

/*******************************************************************************************
  Parameters
*******************************************************************************************/
INTEGER_PARAMETER   _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    _SKIP_,
                    RAMP_TIME,       // Durée du ramp en ms (0-65535)
                    TEMPO,           // Délai appui long en ticks (1 tick = 10ms)
                    SCENE1,          // Niveau scène 1 (0-65535)
                    SCENE2,          // Niveau scène 2 (0-65535)
                    SCENE3,          // Niveau scène 3 (0-65535)
                    SCENE4,          // Niveau scène 4 (0-65535)
                    NIVEAU_MINIMUM,  // Niveau minimum du ramp (0-65535)
                    NIVEAU_MAXIMUM;  // Niveau maximum du ramp (0-65535)

/*******************************************************************************************
  Global Variables
*******************************************************************************************/
INTEGER     LAST_VAR,              // Dernier niveau avant extinction
            SENS_DE_VARIATION,     // Direction du ramp : 0 = descend, 1 = monte
            A_SUBI_UNE_VARIATION;  // Flag : un ramp a eu lieu pendant l'appui

RAMP_INFO   LightInfo;
SIGNED_INTEGER status;

/*******************************************************************************************
  Functions
*******************************************************************************************/

// Met à jour ON_OFF_FB et OFF_FB selon le niveau passé
Function UpdateOnOffFB(INTEGER niveau) {
    IF (niveau > 0) {
        ON_OFF_FB = 1;
        OFF_FB = 0;
    } ELSE {
        ON_OFF_FB = 0;
        OFF_FB = 1;
    }
}

// Lance un ramp dans la direction SENS_DE_VARIATION et bascule la direction pour le prochain appui
Function StartDimRamp() {
    IF (SENS_DE_VARIATION = 0) {
        SENS_DE_VARIATION = 1;
        LightInfo.rampTargetValue = NIVEAU_MAXIMUM;
        LightInfo.rampTransitionTime = RAMP_TIME;
        status = CreateRamp(VAR, LightInfo);
        IF (status <> 0) {
            TRACE("CreateRamp error: %d\n", status);
        }
        VAR_PLUS_FB = 1;
    } ELSE {
        SENS_DE_VARIATION = 0;
        LightInfo.rampTargetValue = NIVEAU_MINIMUM;
        LightInfo.rampTransitionTime = RAMP_TIME;
        status = CreateRamp(VAR, LightInfo);
        IF (status <> 0) {
            TRACE("CreateRamp error: %d\n", status);
        }
        VAR_MOINS_FB = 1;
    }
    ON_OFF_FB = 1;
    OFF_FB = 0;
    A_SUBI_UNE_VARIATION = 1;
}

// Arrête le ramp, sauvegarde le niveau courant et met à jour le feedback
Function StopDimRamp() {
    A_SUBI_UNE_VARIATION = 0;
    StopRamp(VAR);
    VAR_PLUS_FB = 0;
    VAR_MOINS_FB = 0;
    LAST_VAR = VAR;
    UpdateOnOffFB(VAR); // Feedback basé sur le niveau réel après arrêt
}

// Rappelle une scène (appui court) : sauvegarde l'ancien niveau et applique le niveau de scène
Function RecallScene(INTEGER sceneValue) {
    LAST_VAR = VAR_FB;
    VAR = sceneValue;
    UpdateOnOffFB(sceneValue);
    CancelAllWait();
}

/*******************************************************************************************
  Event Handlers
*******************************************************************************************/

CHANGE VAR_FB {
    UpdateOnOffFB(VAR_FB);
}

PUSH ON_OFF {
    IF (VAR_FB = 0) {
        IF (LAST_VAR = 0) {
            LAST_VAR = NIVEAU_MAXIMUM;
        }
        VAR = LAST_VAR;
        PULSE(20, PULSE_ON);
        ON_OFF_FB = 1;
        OFF_FB = 0;
    } ELSE {
        LAST_VAR = VAR_FB;
        VAR = 0;
        PULSE(20, PULSE_OFF);
        ON_OFF_FB = 0;
        OFF_FB = 1;
    }
}

PUSH VAR_CLK {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE VAR_CLK {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        TRACE("VAR_CLK toggle - LAST_VAR: %u\n", LAST_VAR);
        IF (VAR_FB = 0) {
            IF (LAST_VAR = 0) {
                LAST_VAR = NIVEAU_MAXIMUM;
            }
            VAR = LAST_VAR;
            PULSE(20, PULSE_ON);
            ON_OFF_FB = 1;
            OFF_FB = 0;
        } ELSE {
            LAST_VAR = VAR_FB;
            VAR = 0;
            PULSE(20, PULSE_OFF);
            ON_OFF_FB = 0;
            OFF_FB = 1;
        }
        CancelAllWait();
    }
}

PUSH VAR_PLUS_MOINS {
    StartDimRamp();
}

RELEASE VAR_PLUS_MOINS {
    StopRamp(VAR);
    VAR_PLUS_FB = 0;
    VAR_MOINS_FB = 0;
    LAST_VAR = VAR;
}

PUSH VAR_PLUS {
    SENS_DE_VARIATION = 1;
    LightInfo.rampTargetValue = NIVEAU_MAXIMUM;
    LightInfo.rampTransitionTime = RAMP_TIME;
    status = CreateRamp(VAR, LightInfo);
    IF (status <> 0) {
        TRACE("CreateRamp error: %d\n", status);
    }
    ON_OFF_FB = 1;
    OFF_FB = 0;
}

RELEASE VAR_PLUS {
    StopRamp(VAR);
    LAST_VAR = VAR;
}

PUSH VAR_MOINS {
    SENS_DE_VARIATION = 0;
    LightInfo.rampTargetValue = NIVEAU_MINIMUM;
    LightInfo.rampTransitionTime = RAMP_TIME;
    status = CreateRamp(VAR, LightInfo);
    IF (status <> 0) {
        TRACE("CreateRamp error: %d\n", status);
    }
    ON_OFF_FB = 1;
    OFF_FB = 0;
}

RELEASE VAR_MOINS {
    StopRamp(VAR);
    LAST_VAR = VAR;
}

PUSH PRESS_ON {
    IF (LAST_VAR = 0) {
        LAST_VAR = NIVEAU_MAXIMUM;
    }
    VAR = LAST_VAR;
    PULSE(20, PULSE_ON);
    ON_OFF_FB = 1;
    OFF_FB = 0;
}

PUSH PRESS_OFF {
    TRACE("PRESS_OFF - LAST_VAR: %u\n", LAST_VAR);
    IF (VAR_FB > 0) {
        LAST_VAR = VAR_FB;
    }
    VAR = 0;
    PULSE(20, PULSE_OFF);
    ON_OFF_FB = 0;
    OFF_FB = 1;
}

PUSH MEMORISE {
    IF (VAR_FB > 0) {
        LAST_VAR = VAR_FB;
    }
}

PUSH SCENE_1_PRESS {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE SCENE_1_PRESS {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        RecallScene(SCENE1);
    }
}

PUSH SCENE_2_PRESS {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE SCENE_2_PRESS {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        RecallScene(SCENE2);
    }
}

PUSH SCENE_3_PRESS {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE SCENE_3_PRESS {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        RecallScene(SCENE3);
    }
}

PUSH SCENE_4_PRESS {
    WAIT (TEMPO) {
        StartDimRamp();
    }
}

RELEASE SCENE_4_PRESS {
    IF (A_SUBI_UNE_VARIATION = 1) {
        StopDimRamp();
    } ELSE {
        RecallScene(SCENE4);
    }
}

/*******************************************************************************************
  Main()
*******************************************************************************************/
Function Main() {
    SENS_DE_VARIATION = 0;
    A_SUBI_UNE_VARIATION = 0;
    VAR_PLUS_FB = 0;
    VAR_MOINS_FB = 0;
    // Niveau par défaut au démarrage : niveau maximum configuré
    LAST_VAR = NIVEAU_MAXIMUM;
}
